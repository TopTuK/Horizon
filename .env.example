# ---- Docker Compose ---------------------------------------------------------------
WEB_PORT=8080

# ---- Horizon ----------------------------------------------------------------------
# Docker Compose passes this file to the app container, and an API started by hand (uvicorn) reads it
# itself. Nothing is required outside production; production refuses to start without the settings
# marked [production].

# Public origin of the site: the sign-in providers redirect back to it.
#   Docker Compose:           http://localhost:8080
#   Vite dev server:          http://localhost:5173
#   [production]              https://horizon.pmi.moscow
BASE_URL=http://localhost:8080

# "production" refuses to start on unsafe settings (see backend/app/core/config.py).
#APP_ENV=production

# Database password, shared by the database and the app in the Compose stack.
POSTGRES_PASSWORD=horizon
# Only for an API running outside Docker, against the Compose database on its published port.
DATABASE_URL=postgresql+asyncpg://horizon:horizon@localhost:5432/horizon

# Signs the session cookie. [production] a random value of at least 32 characters, for example:
#   tr -dc 'a-f0-9' < /dev/urandom | head -c 64
# Empty outside production means a built-in development key.
SESSION_SECRET_KEY=
# [production] must be true
SESSION_COOKIE_SECURE=false

# Sign-in providers. Each is offered only while its client id is set (OIDC also needs its authority).
# Register BASE_URL plus the callback path as the redirect URI with each provider you enable.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OpenID Connect authority; discovery runs against <authority>/.well-known/openid-configuration
OIDC_AUTHORITY=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A sign-in button that needs no provider (POST /api/dev/test-login), for local checks only.
# docker-compose.test.yml turns it on. [production] must stay false.
ENABLE_TEST_LOGIN=false
